  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.general.enableHeads.@Tooltip[2]": "Por defecto: true",

  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.general.removeVanillaDungeons": "Eliminar Mazmorras Vanilla",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.general.removeVanillaDungeons.@Tooltip[0]": "Evita que aparezcan mazmorras vanilla en el mundo.",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.general.removeVanillaDungeons.@Tooltip[1]": "Se recomienda desactivarlas, ya que las Mazmorras Pequeñas tienen un diseño similar.",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.general.removeVanillaDungeons.@Tooltip[2]": "Por defecto: true",

  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.general.enableNetherBlocks": "Activar Bloques del Nether en Mazmorras",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.general.enableNetherBlocks.@Tooltip[0]": "Algunas mazmorras pueden tener bloques decorativos del Nether como arena de almas, fogatas de alma o faroles de alma.",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.general.enableNetherBlocks.@Tooltip[1]": "Estos bloques serán meramente decorativos: no aparecerán cosas como Escombros Antiguos.",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.general.enableNetherBlocks.@Tooltip[2]": "Desactivá esta opción para evitar que aparezcan bloques relacionados al Nether.",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.general.enableNetherBlocks.@Tooltip[3]": "Esta opción puede ser útil para creadores de modpacks.",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.general.enableNetherBlocks.@Tooltip[4]": "Por defecto: true",

  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.zombieDungeon.zombieDungeonMaxSurfaceStaircaseLength": "Máxima Longitud de Escalera Superficial (Mazmorra de Zombies)",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.zombieDungeon.zombieDungeonMaxSurfaceStaircaseLength.@Tooltip[0]": "Distancia máxima que se verifica al generar una escalera de entrada superficial.",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.zombieDungeon.zombieDungeonMaxSurfaceStaircaseLength.@Tooltip[1]": "Un valor muy alto puede causar problemas.",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.zombieDungeon.zombieDungeonMaxSurfaceStaircaseLength.@Tooltip[2]": "Por defecto: 20",

  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallDungeon.bannerMaxCount": "Máximo de Estandartes por Mazmorra Pequeña",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallDungeon.bannerMaxCount.@Tooltip[0]": "Cantidad máxima de estandartes que pueden aparecer en una mazmorra pequeña.",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallDungeon.bannerMaxCount.@Tooltip[1]": "Por defecto: 2",

  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallDungeon.chestMinCount": "Cantidad Mínima de Cofres (Mazmorra Pequeña)",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallDungeon.chestMinCount.@Tooltip[0]": "Cantidad mínima de cofres que se garantizan en una mazmorra pequeña.",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallDungeon.chestMinCount.@Tooltip[1]": "Por defecto: 1",

  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallDungeon.chestMaxCount": "Cantidad Máxima de Cofres (Mazmorra Pequeña)",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallDungeon.chestMaxCount.@Tooltip[0]": "Cantidad máxima de cofres garantizados en una mazmorra pequeña.",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallDungeon.chestMaxCount.@Tooltip[1]": "Por defecto: 2",

  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallDungeon.enableOreProps": "Permitir Minerales en las Esquinas",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallDungeon.enableOreProps.@Tooltip[0]": "Permite que, en raras ocasiones, las Mazmorras Pequeñas coloquen bloques de mineral en las esquinas.",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallDungeon.enableOreProps.@Tooltip[1]": "Si está desactivado, los bloques de mineral se reemplazarán por aire.",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallDungeon.enableOreProps.@Tooltip[2]": "Por defecto: true",

  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallNetherDungeon.bannerMaxCount": "Máximo de Estandartes (Mazmorra Pequeña del Nether)",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallNetherDungeon.bannerMaxCount.@Tooltip[0]": "Cantidad máxima de estandartes que pueden aparecer en una mazmorra pequeña del Nether.",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallNetherDungeon.bannerMaxCount.@Tooltip[1]": "Por defecto: 2",

  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallNetherDungeon.enabled": "Activar Mazmorras Pequeñas del Nether",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallNetherDungeon.enabled.@Tooltip": "Permitir que aparezcan mazmorras pequeñas en el Nether.",

  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallNetherDungeon.witherSkeletonsDropWitherSkulls": "¿Los Esqueletos Wither sueltan Calaveras?",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallNetherDungeon.witherSkeletonsDropWitherSkulls.@Tooltip": "Define si los esqueletos Wither que aparecen en estas mazmorras pueden soltar calaveras.",

  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallNetherDungeon.blazesDropBlazeRods": "¿Los Blazes sueltan Varas de Blaze?",
  "text.autoconfig.betterdungeons-fabric-1_21.option.betterDungeons.smallNetherDungeon.blazesDropBlazeRods.@Tooltip": "Define si los Blazes de las mazmorras pequeñas del Nether pueden soltar varas de Blaze."
